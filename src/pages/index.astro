// Grid shows thumbnails; lightbox loads full-size via data-full attribute
(function() {
  var overlay = document.getElementById('lightboxOverlay');
  var lbImg = document.getElementById('lightboxImg');
  var galleryItems = [];
  var currentIdx = 0;
  document.querySelectorAll('.gallery-item').forEach(function(item) { galleryItems.push(item); });

  function getFullUrl(idx) {
    var item = galleryItems[idx];
    // data-full has the original high-res URL; fallback to img.src (thumbnail)
    return item.getAttribute('data-full') || item.querySelector('img').src;
  }

  document.querySelectorAll('.gallery-item').forEach(function(item, idx) {
    item.addEventListener('click', function() {
      var img = item.querySelector('img');
      if (!img || !img.src || img.src === window.location.href) return;
      currentIdx = idx;
      lbImg.src = getFullUrl(idx);
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  });
  function closeLB() { overlay.classList.remove('active'); document.body.style.overflow = ''; }
  overlay.addEventListener('click', function(e) { if (e.target === overlay) closeLB(); });
  document.getElementById('lightboxClose').addEventListener('click', closeLB);
  document.getElementById('lightboxPrev').addEventListener('click', function(e) {
    e.stopPropagation();
    currentIdx = (currentIdx - 1 + galleryItems.length) % galleryItems.length;
    lbImg.src = getFullUrl(currentIdx);
  });
  document.getElementById('lightboxNext').addEventListener('click', function(e) {
    e.stopPropagation();
    currentIdx = (currentIdx + 1) % galleryItems.length;
    lbImg.src = getFullUrl(currentIdx);
  });
  document.addEventListener('keydown', function(e) {
    if (!overlay.classList.contains('active')) return;
    if (e.key === 'Escape') closeLB();
    if (e.key === 'ArrowLeft') document.getElementById('lightboxPrev').click();
    if (e.key === 'ArrowRight') document.getElementById('lightboxNext').click();
  });
})();

