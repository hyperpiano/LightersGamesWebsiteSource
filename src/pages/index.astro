<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lightersgames — THANKS, LIGHT.</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
  @import url('https://fonts.cdnfonts.com/css/next-art');

  /* ===== RESET & BASE ===== */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg-deep: #060a10;
    --bg-dark: #0a0f18;
    --bg-card: #101820;
    --text-primary: #e4eaf0;
    --text-secondary: #7a8ea0;
    --accent-gold: #6ec0e8;
    --accent-warm: #90d4f5;
    --accent-light: #d6f0ff;
    --accent-blue: #4a9cff;
    --accent-red: #e85050;
    --gradient-hero: linear-gradient(135deg, #060a10 0%, #0c1420 50%, #0a1018 100%);
  }

  html { scroll-behavior: smooth; font-size: 16px; }
  body {
    font-family: 'Inter', -apple-system, sans-serif;
    background: var(--bg-deep);
    color: var(--text-primary);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* ===== CUSTOM CURSOR LIGHT ===== */
  .cursor-light {
    position: fixed;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(110,192,232,0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease;
    mix-blend-mode: screen;
  }

  /* ===== NAV ===== */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(10,10,15,0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(110,192,232,0.1);
    transition: all 0.3s ease;
  }
  nav.scrolled {
    padding: 0.7rem 2rem;
    background: rgba(10,10,15,0.95);
  }
  .nav-logo {
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
    text-decoration: none;
  }
  .nav-logo span { color: var(--text-secondary); font-weight: 400; font-size: 0.8rem; margin-left: 0.5rem; }
  .nav-links { display: flex; gap: 2rem; align-items: center; }
  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.3s;
    position: relative;
  }
  .nav-links a:hover { color: var(--accent-gold); }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent-gold);
    transition: width 0.3s;
  }
  .nav-links a:hover::after { width: 100%; }
  .nav-cta {
    background: var(--accent-gold) !important;
    color: var(--bg-deep) !important;
    padding: 0.5rem 1.2rem;
    border-radius: 4px;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    font-size: 0.8rem !important;
    letter-spacing: 0.08em !important;
    transition: all 0.3s !important;
  }
  .nav-cta:hover { background: var(--accent-warm) !important; transform: translateY(-1px); }
  .nav-cta::after { display: none !important; }

  /* Nav dropdown */
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(26,26,36,0.98);
    border: 1px solid rgba(110,192,232,0.15);
    border-radius: 8px;
    padding: 0.5rem 0;
    min-width: 200px;
    backdrop-filter: blur(20px);
    z-index: 1001;
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }
  .nav-dropdown:hover .nav-dropdown-menu { display: block; }
  .nav-dropdown-menu a {
    display: block !important;
    padding: 0.6rem 1.2rem !important;
    font-size: 0.85rem !important;
    white-space: nowrap;
    transition: background 0.2s !important;
  }
  .nav-dropdown-menu a:hover {
    background: rgba(110,192,232,0.08) !important;
  }
  .nav-dropdown-menu .dd-badge {
    display: inline-block;
    font-size: 0.6rem;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    margin-left: 0.5rem;
    vertical-align: middle;
    letter-spacing: 0.05em;
  }
  .dd-badge-live { background: rgba(110,232,150,0.15); color: #6ee896; }
  .dd-badge-soon { background: rgba(110,192,232,0.15); color: var(--accent-gold); }

  /* Mobile nav */
  .nav-toggle { display: none; background: none; border: none; color: var(--text-primary); font-size: 1.5rem; cursor: pointer; }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: var(--gradient-hero);
    overflow: hidden;
  }
  .hero-video-bg {
    position: absolute;
    top: 50%; left: 50%;
    min-width: 100%; min-height: 100%;
    width: auto; height: auto;
    transform: translate(-50%, -50%);
    z-index: 0;
    object-fit: cover;
    opacity: 0.25;
    filter: brightness(0.5) saturate(0.7);
  }
  .hero-video-bg-yt {
    position: absolute;
    top: 50%; left: 50%;
    width: 177.78vh; /* 16:9 ratio */
    height: 100vh;
    min-width: 100%; min-height: 100%;
    transform: translate(-50%, -50%);
    z-index: 0;
    opacity: 0.3;
    filter: brightness(0.5) saturate(0.7);
    pointer-events: none;
    border: none;
  }
  .hero-video-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    background: linear-gradient(to bottom, rgba(6,10,16,0.6) 0%, rgba(6,10,16,0.3) 40%, rgba(6,10,16,0.7) 100%);
  }
  .hero-bg-canvas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    opacity: 0.4;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    padding: 0 2rem;
  }
  .hero-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 1.5rem;
    font-weight: 500;
    opacity: 0;
    animation: fadeUp 1s ease 0.3s forwards;
  }
  .hero-title {
    font-family: 'NEXT ART', 'Inter', sans-serif;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.06em;
    line-height: 0.92;
    margin-bottom: 0.8rem;
    opacity: 0;
    animation: fadeUp 1s ease 0.5s forwards;
  }
  .hero-title em {
    font-style: italic;
    color: var(--accent-light);
  }
  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    font-weight: 300;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;
    animation: fadeUp 1s ease 0.7s forwards;
  }
  .hero-cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 1s ease 0.9s forwards;
  }
  .btn-primary {
    background: var(--accent-gold);
    color: var(--bg-deep);
    padding: 0.9rem 2rem;
    border: none;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-primary:hover { background: var(--accent-warm); transform: translateY(-2px); box-shadow: 0 8px 30px rgba(110,192,232,0.3); }
  .btn-secondary {
    background: transparent;
    color: var(--text-primary);
    padding: 0.9rem 2rem;
    border: 1px solid rgba(240,236,228,0.2);
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
  }
  .btn-secondary:hover { border-color: var(--accent-gold); color: var(--accent-gold); }

  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    animation: fadeIn 1s ease 1.5s forwards;
  }
  .hero-scroll-hint span {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--accent-gold), transparent);
    animation: scrollPulse 2s ease infinite;
  }

  /* ===== INTERACTIVE LIGHT SHAPE (Hero) ===== */
  .hero-interactive {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    opacity: 0.15;
  }
  .hex-container {
    width: 400px;
    height: 400px;
    position: relative;
  }
  .hex-shape {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    transition: all 1.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hex-shape.morphed {
    border-radius: 50%;
    box-shadow: 0 0 80px rgba(110,192,232,0.4), 0 0 160px rgba(110,192,232,0.1);
  }

  /* ===== SECTIONS COMMON ===== */
  section {
    padding: 8rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-label {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  .section-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }
  .section-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 600px;
    line-height: 1.7;
    font-weight: 300;
  }

  /* ===== ABOUT ===== */
  .about-section {
    position: relative;
    background: var(--bg-dark);
    max-width: 100%;
    padding: 8rem 2rem;
  }
  .about-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .about-visual {
    position: relative;
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
    background: #182030;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* 3D Cube Interactive — Orthographic, Hexagon silhouette */
  .cube-scene {
    width: 180px;
    height: 180px;
    /* No perspective = orthographic projection */
    margin: 0 auto;
  }
  .cube {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    /* Vertex-on angle: looks like a perfect hexagon */
    transform: rotateX(-35.264deg) rotateY(45deg);
    transition: transform 0.1s ease-out;
  }
  .cube-face {
    position: absolute;
    width: 180px;
    height: 180px;
    border: none;
    outline: none;
    /* Filled dark — distinct hexagon silhouette against lighter bg */
    background: #080e18;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: transparent;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: all 0.5s ease;
    backface-visibility: visible;
  }
  .cube-face.lit {
    border: 1px solid rgba(110,192,232,0.5);
    background: rgba(12,20,32,0.95);
    box-shadow: inset 0 0 40px rgba(110,192,232,0.1), 0 0 25px rgba(110,192,232,0.15);
    color: rgba(110,192,232,0.5);
  }
  .cube-face--front  { transform: translateZ(90px); }
  .cube-face--back   { transform: rotateY(180deg) translateZ(90px); }
  .cube-face--right  { transform: rotateY(90deg) translateZ(90px); }
  .cube-face--left   { transform: rotateY(-90deg) translateZ(90px); }
  .cube-face--top    { transform: rotateX(90deg) translateZ(90px); }
  .cube-face--bottom { transform: rotateX(-90deg) translateZ(90px); }

  .about-visual-label {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all 0.3s;
  }

  /* 3D Shape Simulator */
  .shape-sim {
    background: var(--bg-card);
    border: 1px solid rgba(240,236,228,0.06);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    max-width: 100%;
  }
  .shape-sim canvas {
    display: block;
    margin: 0 auto;
    border-radius: 8px;
    cursor: grab;
    background: var(--bg-deep);
  }
  .shape-sim canvas:active { cursor: grabbing; }
  .shape-sim-labels {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  .shape-label {
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(240,236,228,0.05);
    color: var(--text-secondary);
    transition: all 0.3s;
  }
  .shape-label.active {
    background: rgba(110,192,232,0.15);
    color: var(--accent-gold);
    border: 1px solid rgba(110,192,232,0.3);
  }
  .feature-list {
    list-style: none;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .feature-icon {
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-radius: 50%;
    background: rgba(110,192,232,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-gold);
    font-size: 0.8rem;
    margin-top: 2px;
  }

  /* ===== TRAILER ===== */
  .trailer-section {
    text-align: center;
  }
  .trailer-wrapper {
    margin-top: 3rem;
    position: relative;
    width: 100%;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    border: 1px solid rgba(110,192,232,0.1);
  }
  .trailer-wrapper::before {
    content: '';
    display: block;
    padding-top: 56.25%;
  }
  .trailer-wrapper iframe,
  .trailer-placeholder {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .trailer-placeholder {
    background: var(--bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
    cursor: pointer;
    transition: background 0.3s;
  }
  .trailer-placeholder:hover { background: #222233; }
  .play-btn {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
  }
  .play-btn::after {
    content: '';
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 12px 0 12px 22px;
    border-color: transparent transparent transparent var(--bg-deep);
    margin-left: 4px;
  }
  .trailer-placeholder:hover .play-btn {
    transform: scale(1.1);
    box-shadow: 0 0 40px rgba(110,192,232,0.4);
  }

  /* ===== SCREENSHOTS ===== */
  .screenshots-section { text-align: center; }
  .gallery-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .gallery-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16/9;
    background: var(--bg-card);
    cursor: pointer;
    transition: transform 0.3s;
  }
  .gallery-item:hover { transform: scale(1.02); }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s;
  }
  .gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,15,0.6), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gallery-item:hover::after { opacity: 1; }
  .gallery-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: linear-gradient(135deg, var(--bg-card), #1e1e2e);
  }

  /* ===== PLATFORMS ===== */
  .platforms-section {
    text-align: center;
    background: var(--bg-dark);
    max-width: 100%;
    padding: 6rem 2rem;
  }
  .platforms-inner { max-width: 1200px; margin: 0 auto; }
  .platform-grid {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .platform-card {
    background: var(--bg-card);
    border: 1px solid rgba(240,236,228,0.06);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    text-align: center;
    min-width: 180px;
    transition: all 0.3s;
  }
  .platform-card:hover {
    border-color: var(--accent-gold);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3);
  }
  .platform-card .platform-icon {
    font-size: 2rem;
    margin-bottom: 0.8rem;
  }
  .platform-card .platform-name {
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.3rem;
  }
  .platform-card .platform-status {
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .platform-card .platform-status.available { color: #6bcf6b; }

  /* ===== TEAM ===== */
  .team-section { text-align: center; }
  .team-grid {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }
  .team-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.2rem;
    border-radius: 8px;
    background: var(--bg-card);
    border: 1px solid rgba(240,236,228,0.04);
    transition: all 0.3s;
  }
  .team-card:hover {
    border-color: rgba(110,192,232,0.2);
    transform: translateY(-2px);
  }
  .team-avatar {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-gold), var(--accent-warm));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    color: var(--bg-deep);
    font-weight: 700;
  }
  .team-name {
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }
  .team-role {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* ===== PRESS KIT ===== */
  .press-section {
    background: var(--bg-dark);
    max-width: 100%;
    padding: 6rem 2rem;
  }
  .press-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .press-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .press-fact {
    background: var(--bg-card);
    padding: 1.2rem;
    border-radius: 8px;
    border: 1px solid rgba(240,236,228,0.04);
  }
  .press-fact-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.3rem;
  }
  .press-fact-value {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .press-downloads { margin-top: 2rem; }
  .press-downloads h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .download-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .download-list li a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    background: var(--bg-card);
    border: 1px solid rgba(240,236,228,0.06);
    border-radius: 8px;
    text-decoration: none;
