<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lightersgames — Content Admin</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Inter', -apple-system, sans-serif; background: #0a0f18; color: #e4eaf0; padding: 2rem; line-height: 1.6; }
  h1 { font-size: 1.5rem; margin-bottom: 0.5rem; color: #6ec0e8; }
  h2 { font-size: 1.1rem; margin: 2rem 0 0.8rem; color: #90d4f5; border-bottom: 1px solid rgba(110,192,232,0.2); padding-bottom: 0.5rem; }
  h3 { font-size: 0.9rem; margin: 1.2rem 0 0.5rem; color: #d6f0ff; }
  .subtitle { color: #7a8ea0; font-size: 0.85rem; margin-bottom: 2rem; }
  .field { margin-bottom: 1rem; }
  label { display: block; font-size: 0.8rem; color: #7a8ea0; margin-bottom: 0.3rem; text-transform: uppercase; letter-spacing: 0.05em; }
  input[type="text"], input[type="url"], textarea {
    width: 100%; padding: 0.6rem 0.8rem; background: #101820; border: 1px solid rgba(110,192,232,0.2);
    border-radius: 6px; color: #e4eaf0; font-size: 0.85rem; font-family: monospace;
  }
  input:focus, textarea:focus { outline: none; border-color: #6ec0e8; }
  textarea { min-height: 60px; resize: vertical; }
  .preview-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 0.5rem; }
  .preview-card {
    background: #101820; border: 1px solid rgba(110,192,232,0.1); border-radius: 8px;
    padding: 0.8rem; text-align: center;
  }
  .preview-card img {
    width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 4px;
    background: #060a10; display: block; margin-bottom: 0.5rem;
  }
  .preview-card .placeholder {
    width: 100%; aspect-ratio: 16/9; background: #060a10; border-radius: 4px;
    display: flex; align-items: center; justify-content: center; color: #7a8ea0;
    font-size: 0.75rem; margin-bottom: 0.5rem;
  }
  .btn {
    display: inline-block; padding: 0.5rem 1.2rem; background: #6ec0e8; color: #060a10;
    border: none; border-radius: 6px; font-size: 0.85rem; font-weight: 600;
    cursor: pointer; margin-top: 0.5rem; transition: background 0.2s;
  }
  .btn:hover { background: #90d4f5; }
  .btn-secondary {
    background: transparent; border: 1px solid rgba(110,192,232,0.3); color: #6ec0e8;
  }
  .btn-secondary:hover { background: rgba(110,192,232,0.1); }
  .btn-danger { background: #e85050; }
  .btn-danger:hover { background: #ff6666; }
  .status { margin-top: 1rem; padding: 0.6rem 1rem; border-radius: 6px; font-size: 0.85rem; display: none; }
  .status.success { display: block; background: rgba(110,192,232,0.1); border: 1px solid rgba(110,192,232,0.3); color: #6ec0e8; }
  .status.error { display: block; background: rgba(232,80,80,0.1); border: 1px solid rgba(232,80,80,0.3); color: #e85050; }
  .section-box { background: #0c1420; border: 1px solid rgba(110,192,232,0.08); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem; }
  .export-box { margin-top: 2rem; padding: 1rem; background: #101820; border-radius: 8px; }
  .export-box textarea { min-height: 100px; font-size: 0.75rem; }
  .video-slot { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
  .video-slot input { flex: 1; }
  .video-slot .remove-btn { cursor: pointer; color: #e85050; font-size: 1rem; padding: 0.3rem; }
  .add-video-btn { font-size: 0.8rem; color: #6ec0e8; cursor: pointer; background: none; border: 1px dashed rgba(110,192,232,0.3); padding: 0.4rem 0.8rem; border-radius: 4px; }
  .add-video-btn:hover { background: rgba(110,192,232,0.05); }
  @media (max-width: 768px) { .preview-row { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<h1>Lightersgames Content Admin</h1>
<p class="subtitle">이 페이지에서 이미지와 영상을 관리하면 본 사이트(lightersgames-prototype.html)에 자동 반영됩니다.</p>

<!-- Hero Section -->
<div class="section-box">
  <h2>Hero Background Video</h2>
  <div class="field">
    <label>Video URL (WebM or MP4)</label>
    <input type="url" id="hero-video-url" placeholder="https://cdn.akamai.steamstatic.com/steam/apps/...">
  </div>
  <div class="field">
    <label>Poster Image URL (optional fallback)</label>
    <input type="url" id="hero-poster-url" placeholder="https://...">
  </div>
</div>

<!-- Trailer Section -->
<div class="section-box">
  <h2>Trailer YouTube</h2>
  <div class="field">
    <label>YouTube Video ID (예: dQw4w9WgXcQ)</label>
    <input type="text" id="trailer-youtube-id" placeholder="YouTube Video ID">
  </div>
  <div id="trailer-extra-videos">
    <h3>Additional Videos</h3>
    <div id="extra-videos-list"></div>
    <button class="add-video-btn" onclick="addExtraVideo()">+ Add Video</button>
  </div>
</div>

<!-- Screenshots Chapter 1 -->
<div class="section-box">
  <h2>Chapter 1 — Illuminate</h2>
  <div class="preview-row">
    <div class="preview-card">
      <div class="placeholder" id="preview-ch1-1">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch1-1" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
    <div class="preview-card">
      <div class="placeholder" id="preview-ch1-2">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch1-2" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
    <div class="preview-card">
      <div class="placeholder" id="preview-ch1-3">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch1-3" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
  </div>
</div>

<!-- Screenshots Chapter 2 -->
<div class="section-box">
  <h2>Chapter 2 — Absorb</h2>
  <div class="preview-row">
    <div class="preview-card">
      <div class="placeholder" id="preview-ch2-1">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch2-1" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
    <div class="preview-card">
      <div class="placeholder" id="preview-ch2-2">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch2-2" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
    <div class="preview-card">
      <div class="placeholder" id="preview-ch2-3">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch2-3" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
  </div>
</div>

<!-- Screenshots Chapter 3 -->
<div class="section-box">
  <h2>Chapter 3 — Mirror, Lens & Merge</h2>
  <div class="preview-row">
    <div class="preview-card">
      <div class="placeholder" id="preview-ch3-1">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch3-1" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
    <div class="preview-card">
      <div class="placeholder" id="preview-ch3-2">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch3-2" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
    <div class="preview-card">
      <div class="placeholder" id="preview-ch3-3">No image</div>
      <div class="field"><label>Image URL</label><input type="url" data-slot="ch3-3" placeholder="https://..." oninput="updatePreview(this)"></div>
    </div>
  </div>
</div>

<!-- Downloads (Press Kit) -->
<div class="section-box">
  <h2>Press Kit Downloads</h2>
  <p style="font-size:0.8rem; color:#7a8ea0; margin-bottom:1rem;">각 다운로드 항목의 URL을 설정합니다. 빈칸이면 기본 '#' 링크가 유지됩니다.</p>
  <div class="field">
    <label>Full Press Kit (ZIP)</label>
    <input type="url" id="dl-presskit" placeholder="https://drive.google.com/...">
  </div>
  <div class="field">
    <label>Logo & Brand Assets</label>
    <input type="url" id="dl-logo" placeholder="https://drive.google.com/...">
  </div>
  <div class="field">
    <label>Screenshot Pack (High-res)</label>
    <input type="url" id="dl-screenshots" placeholder="https://drive.google.com/...">
  </div>
  <div class="field">
    <label>Fact Sheet (PDF)</label>
    <input type="url" id="dl-factsheet" placeholder="https://drive.google.com/...">
  </div>
</div>

<!-- Community Links -->
<div class="section-box">
  <h2>Community Links</h2>
  <p style="font-size:0.8rem; color:#7a8ea0; margin-bottom:1rem;">각 커뮤니티 채널의 URL을 설정합니다.</p>
  <div class="field">
    <label>Discord</label>
    <input type="url" id="link-discord" placeholder="https://discord.gg/...">
  </div>
  <div class="field">
    <label>X / Twitter</label>
    <input type="url" id="link-twitter" placeholder="https://x.com/...">
  </div>
  <div class="field">
    <label>YouTube</label>
    <input type="url" id="link-youtube" placeholder="https://youtube.com/@...">
  </div>
  <div class="field">
    <label>Reddit</label>
    <input type="url" id="link-reddit" placeholder="https://www.reddit.com/r/ThanksLight/">
  </div>
  <div class="field">
    <label>Steam Store Page</label>
    <input type="url" id="link-steam" placeholder="https://store.steampowered.com/app/2544740/THANKS_LIGHT/">
  </div>
</div>

<!-- Actions -->
<div style="background: #0c1420; border: 2px solid rgba(110,192,232,0.3); border-radius: 10px; padding: 1.5rem; margin-top: 2rem;">
  <h2 style="margin-top:0; border:none; padding:0;">Save & Deploy</h2>
  <p style="font-size:0.85rem; color:#7a8ea0; margin-bottom:1rem;">
    <strong style="color:#6ec0e8;">사용 방법:</strong> 아래 버튼으로 <code>site-content.json</code> 파일을 다운로드한 뒤,
    GitHub 리포의 <code>public/js/</code> 폴더에 업로드하세요.
    Vercel이 자동으로 배포합니다.
  </p>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
    <button class="btn" onclick="downloadJSON()" style="font-size:1rem; padding:0.7rem 1.5rem;">Download site-content.json</button>
    <button class="btn btn-secondary" onclick="saveAll()">Save to LocalStorage (로컬용)</button>
    <button class="btn btn-secondary" onclick="importJSON()">Import JSON</button>
    <button class="btn btn-danger" onclick="clearAll()">Clear All</button>
  </div>
</div>

<div class="status" id="statusMsg"></div>

<!-- Export/Import -->
<div class="export-box" id="exportBox" style="display:none;">
  <label>JSON Data (paste here to import)</label>
  <textarea id="jsonArea"></textarea>
  <div style="margin-top: 0.5rem;">
    <button class="btn btn-secondary" onclick="applyImport()">Apply Import</button>
  </div>
</div>

<script>
const STORAGE_KEY = 'lightersgames-content';

// Screenshot slots
const SLOTS = ['ch1-1','ch1-2','ch1-3','ch2-1','ch2-2','ch2-3','ch3-1','ch3-2','ch3-3'];

let extraVideos = [];

const DL_FIELDS = ['dl-presskit','dl-logo','dl-screenshots','dl-factsheet'];
const LINK_FIELDS = ['link-discord','link-twitter','link-youtube','link-reddit','link-steam'];

function getData() {
  const data = {
    heroVideoUrl: document.getElementById('hero-video-url').value,
    heroPosterUrl: document.getElementById('hero-poster-url').value,
    trailerYoutubeId: document.getElementById('trailer-youtube-id').value,
    extraVideos: extraVideos,
    screenshots: {},
    downloads: {},
    communityLinks: {}
  };
  SLOTS.forEach(slot => {
    const input = document.querySelector(`input[data-slot="${slot}"]`);
    if (input && input.value) data.screenshots[slot] = input.value;
  });
  DL_FIELDS.forEach(id => {
    const v = document.getElementById(id).value;
    if (v) data.downloads[id] = v;
  });
  LINK_FIELDS.forEach(id => {
    const v = document.getElementById(id).value;
    if (v) data.communityLinks[id] = v;
  });
  return data;
}

function setData(data) {
  if (!data) return;
  document.getElementById('hero-video-url').value = data.heroVideoUrl || '';
  document.getElementById('hero-poster-url').value = data.heroPosterUrl || '';
  document.getElementById('trailer-youtube-id').value = data.trailerYoutubeId || '';
  extraVideos = data.extraVideos || [];
  renderExtraVideos();
  SLOTS.forEach(slot => {
    const input = document.querySelector(`input[data-slot="${slot}"]`);
    if (input && data.screenshots && data.screenshots[slot]) {
      input.value = data.screenshots[slot];
      updatePreview(input);
    }
  });
  if (data.downloads) {
    DL_FIELDS.forEach(id => {
      if (data.downloads[id]) document.getElementById(id).value = data.downloads[id];
    });
  }
  if (data.communityLinks) {
    LINK_FIELDS.forEach(id => {
      if (data.communityLinks[id]) document.getElementById(id).value = data.communityLinks[id];
    });
  }
}

function updatePreview(input) {
  const slot = input.dataset.slot;
  const previewEl = document.getElementById('preview-' + slot);
  const url = input.value.trim();
  if (url) {
    previewEl.outerHTML = `<img id="preview-${slot}" src="${url}" alt="${slot}" onerror="this.outerHTML='<div class=placeholder id=preview-${slot}>Failed to load</div>'">`;
  } else {
    if (previewEl.tagName === 'IMG') {
      previewEl.outerHTML = `<div class="placeholder" id="preview-${slot}">No image</div>`;
    }
  }
}

function addExtraVideo(url, title) {
  extraVideos.push({ url: url || '', title: title || '' });
  renderExtraVideos();
}

function removeExtraVideo(idx) {
  extraVideos.splice(idx, 1);
  renderExtraVideos();
}

function renderExtraVideos() {
  const list = document.getElementById('extra-videos-list');
  list.innerHTML = '';
  extraVideos.forEach((v, i) => {
    const div = document.createElement('div');
    div.className = 'video-slot';
    div.innerHTML = `
      <input type="text" placeholder="Title" value="${v.title}" onchange="extraVideos[${i}].title=this.value">
      <input type="url" placeholder="YouTube URL or ID" value="${v.url}" onchange="extraVideos[${i}].url=this.value">
      <span class="remove-btn" onclick="removeExtraVideo(${i})">×</span>
    `;
    list.appendChild(div);
  });
}

function saveAll() {
  const data = getData();
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  showStatus('Saved to localStorage (로컬 미리보기용).', 'success');
}

function downloadJSON() {
  const data = getData();
  const json = JSON.stringify(data, null, 2);
  const blob = new Blob([json], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'site-content.json';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showStatus('site-content.json 다운로드 완료! GitHub 리포에 업로드하세요.', 'success');
}

function exportJSON() {
  const data = getData();
  document.getElementById('jsonArea').value = JSON.stringify(data, null, 2);
  document.getElementById('exportBox').style.display = 'block';
}

function importJSON() {
  document.getElementById('jsonArea').value = '';
  document.getElementById('exportBox').style.display = 'block';
  showStatus('Paste JSON data into the text area and click "Apply Import".', 'success');
}

function applyImport() {
  try {
    const data = JSON.parse(document.getElementById('jsonArea').value);
    setData(data);
    showStatus('Imported successfully!', 'success');
  } catch (e) {
    showStatus('Invalid JSON: ' + e.message, 'error');
  }
}

function copyJSON() {
  const area = document.getElementById('jsonArea');
  area.select();
  document.execCommand('copy');
  showStatus('Copied to clipboard!', 'success');
}

function clearAll() {
  if (!confirm('Are you sure you want to clear all content data?')) return;
  localStorage.removeItem(STORAGE_KEY);
  document.querySelectorAll('input[type="url"], input[type="text"]').forEach(i => i.value = '');
  SLOTS.forEach(slot => {
    const el = document.getElementById('preview-' + slot);
    if (el && el.tagName === 'IMG') {
      el.outerHTML = `<div class="placeholder" id="preview-${slot}">No image</div>`;
    }
  });
  extraVideos = [];
  renderExtraVideos();
  showStatus('All data cleared.', 'success');
}

function showStatus(msg, type) {
  const el = document.getElementById('statusMsg');
  el.textContent = msg;
  el.className = 'status ' + type;
  setTimeout(() => { el.style.display = 'none'; el.className = 'status'; }, 4000);
}

// Load saved data on page open
const saved = localStorage.getItem(STORAGE_KEY);
if (saved) {
  try { setData(JSON.parse(saved)); } catch(e) {}
}
</script>

</body>
</html>
