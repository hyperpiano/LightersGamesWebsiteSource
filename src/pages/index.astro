<script is:inline>
// ===== CURSOR LIGHT EFFECT =====
const cursorLight = document.getElementById('cursorLight');
let mouseX = 0, mouseY = 0;
let lightX = 0, lightY = 0;

document.addEventListener('mousemove', (e) => {
  mouseX = e.clientX;
  mouseY = e.clientY;
});

function animateLight() {
  lightX += (mouseX - lightX) * 0.08;
  lightY += (mouseY - lightY) * 0.08;
  cursorLight.style.left = lightX + 'px';
  cursorLight.style.top = lightY + 'px';
  requestAnimationFrame(animateLight);
}
animateLight();

// ===== HERO CANVAS — Particle starfield =====
const canvas = document.getElementById('heroCanvas');
const ctx = canvas.getContext('2d');
let particles = [];

function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

class Particle {
  constructor() {
    this.reset();
  }
  reset() {
    this.x = Math.random() * canvas.width;
    this.y = Math.random() * canvas.height;
    this.size = Math.random() * 1.5 + 0.3;
    this.speedX = (Math.random() - 0.5) * 0.2;
    this.speedY = (Math.random() - 0.5) * 0.2;
    this.opacity = Math.random() * 0.5 + 0.1;
    this.pulse = Math.random() * Math.PI * 2;
  }
  update() {
    this.x += this.speedX;
    this.y += this.speedY;
    this.pulse += 0.02;

    // Mouse influence
    const dx = mouseX - this.x;
    const dy = mouseY - this.y;
    const dist = Math.sqrt(dx*dx + dy*dy);
    if (dist < 200) {
      const force = (200 - dist) / 200 * 0.3;
      this.x -= dx * force * 0.005;
      this.y -= dy * force * 0.005;
    }

    if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) {
      this.reset();
    }
  }
  draw() {
    const alpha = this.opacity * (0.5 + Math.sin(this.pulse) * 0.5);
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(110,192,232,${alpha})`;
    ctx.fill();
  }
}

for (let i = 0; i < 100; i++) {
  particles.push(new Particle());
}

function animateParticles() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  particles.forEach(p => { p.update(); p.draw(); });
  requestAnimationFrame(animateParticles);
}
animateParticles();

// ===== NAV SCROLL =====
window.addEventListener('scroll', () => {
  document.getElementById('mainNav').classList.toggle('scrolled', window.scrollY > 50);
});

// ===== SCROLL REVEAL =====
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.15 });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ===== 3D CUBE LIGHT REVEAL =====
const cubeEl = document.getElementById('cubeEl');
const aboutVisual = document.getElementById('aboutVisual');
const shapeLabel = document.getElementById('shapeLabel');
const cubeFaces = document.querySelectorAll('.cube-face');

if (aboutVisual && cubeEl) {
  const baseRotX = -35.264;
  const baseRotY = 45;

  function handleCubeInteraction(clientX, clientY) {
    const rect = aboutVisual.getBoundingClientRect();
    const mx = (clientX - rect.left) / rect.width;
    const my = (clientY - rect.top) / rect.height;
    const rotY = baseRotY + (mx - 0.5) * 25;
    const rotX = baseRotX + (my - 0.5) * 20;
    cubeEl.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;

    cubeFaces.forEach(face => {
      const fr = face.getBoundingClientRect();
      const fcx = fr.left + fr.width/2;
      const fcy = fr.top + fr.height/2;
      const dist = Math.sqrt((clientX-fcx)**2 + (clientY-fcy)**2);
      face.classList.toggle('lit', dist < 200);
    });
    shapeLabel.textContent = 'Light reveals it\'s a cube — with weight and physics';
    shapeLabel.style.color = 'var(--accent-gold)';
  }

  function resetCube() {
    cubeEl.style.transform = `rotateX(${baseRotX}deg) rotateY(${baseRotY}deg)`;
    cubeFaces.forEach(f => f.classList.remove('lit'));
    shapeLabel.textContent = 'Hover to shine light on the silhouette';
    shapeLabel.style.color = '';
  }

  // Desktop: mouse
  aboutVisual.addEventListener('mousemove', (e) => handleCubeInteraction(e.clientX, e.clientY));
  aboutVisual.addEventListener('mouseleave', resetCube);

  // Mobile: touch — move finger to shine light, prevents scroll within cube area
  aboutVisual.addEventListener('touchstart', (e) => {
    const t = e.touches[0];
    handleCubeInteraction(t.clientX, t.clientY);
    e.preventDefault();
  }, { passive: false });

  aboutVisual.addEventListener('touchmove', (e) => {
    const t = e.touches[0];
    handleCubeInteraction(t.clientX, t.clientY);
    e.preventDefault();
  }, { passive: false });

  aboutVisual.addEventListener('touchend', resetCube);
}

// ===== 3D SHAPE SIMULATOR (Circle/Square/Triangle) =====
// Voxel point-cloud rendering — intersection of cylinder, square prism, triangular prism
const simCanvas = document.getElementById('shapeSim');
if (simCanvas) {
  const sCtx = simCanvas.getContext('2d');
  let isDragging = false;
  let angleX = 0.4, angleY = 0.6;
  let lastMX, lastMY;
  const W = simCanvas.width, H = simCanvas.height;
  const R = 85;
  const step = 4;

  function rot(x, y, z, aX, aY) {
    let cY2 = Math.cos(aY), sY = Math.sin(aY);
    let x1 = x*cY2 - z*sY, z1 = x*sY + z*cY2;
    let cX2 = Math.cos(aX), sX = Math.sin(aX);
    return { x: x1, y: y*cX2 - z1*sX, z: y*sX + z1*cX2 };
  }

  // Solid = intersection of cylinder(Z), square-prism(X), triangular-prism(Y)
  function insideSolid(x, y, z) {
    if (x*x + y*y > R*R) return false;
    if (Math.abs(y) > R || Math.abs(z) > R) return false;
    if (Math.abs(x) > (R - z) / 2) return false;
    return true;
  }

  // Pre-compute surface voxels
  const surfacePoints = [];
  for (let x = -R; x <= R; x += step) {
    for (let y = -R; y <= R; y += step) {
      for (let z = -R; z <= R; z += step) {
        if (!insideSolid(x, y, z)) continue;
        // Check if it's a surface voxel (at least one neighbor outside)
        let isSurface = false;
        for (const d of [[-step,0,0],[step,0,0],[0,-step,0],[0,step,0],[0,0,-step],[0,0,step]]) {
          if (!insideSolid(x+d[0], y+d[1], z+d[2])) { isSurface = true; break; }
        }
        if (isSurface) surfacePoints.push({x, y, z});
      }
    }
  }

  function drawShape(aX, aY) {
    sCtx.clearRect(0, 0, W, H);
    const cX = W/2, cY = H/2;
    sCtx.fillStyle = '#060a10';
    sCtx.fillRect(0, 0, W, H);

    // Light direction
    const lx = 0.4, ly = -0.5, lz = -0.7;
    const ll = Math.sqrt(lx*lx + ly*ly + lz*lz);

    // Transform and sort by depth
    const projected = [];
    for (const p of surfacePoints) {
      const r = rot(p.x, p.y, p.z, aX, aY);
      // Approximate normal from position (good enough for convex-ish shape)
      const nx = p.x, ny = p.y, nz = p.z;
      const nl = Math.sqrt(nx*nx + ny*ny + nz*nz) || 1;
      const rn = rot(nx/nl, ny/nl, nz/nl, aX, aY);
      const dot = Math.max(0, -(rn.x*lx + rn.y*ly + rn.z*lz) / ll);
      const b = 0.15 + dot * 0.85;
      projected.push({ sx: cX + r.x, sy: cY + r.y, z: r.z, b });
    }
    projected.sort((a, b) => a.z - b.z);

    // Draw points
    for (const p of projected) {
      const r = Math.round(40 + 120 * p.b);
      const g = Math.round(120 + 110 * p.b);
      const bl = Math.round(180 + 75 * p.b);
      sCtx.fillStyle = `rgb(${r},${g},${bl})`;
      sCtx.fillRect(p.sx - 2, p.sy - 2, 4, 4);
    }

    // Subtle grid
    sCtx.strokeStyle = 'rgba(110,192,232,0.04)';
    sCtx.lineWidth = 0.5;
    for (let g = -2; g <= 2; g++) {
      sCtx.beginPath(); sCtx.moveTo(0, cY+g*40); sCtx.lineTo(W, cY+g*40); sCtx.stroke();
      sCtx.beginPath(); sCtx.moveTo(cX+g*40, 0); sCtx.lineTo(cX+g*40, H); sCtx.stroke();
    }
    detectShape(aX, aY);
  }

  function detectShape(aX, aY) {
    const lblC = document.getElementById('lblCircle');
    const lblS = document.getElementById('lblSquare');
    const lblT = document.getElementById('lblTriangle');
    [lblC,lblS,lblT].forEach(l => l.classList.remove('active'));
    let ny = ((aY % (Math.PI*2)) + Math.PI*2) % (Math.PI*2);
    let nx = ((aX % (Math.PI*2)) + Math.PI*2) % (Math.PI*2);
    const tol = 0.45;
    if ((ny < tol || ny > Math.PI*2-tol || Math.abs(ny-Math.PI) < tol) && (nx < tol || nx > Math.PI*2-tol || Math.abs(nx-Math.PI) < tol)) {
      lblC.classList.add('active');
    }
    if (Math.abs(ny - Math.PI/2) < tol || Math.abs(ny - Math.PI*3/2) < tol) {
      lblS.classList.add('active');
    }
    if (Math.abs(nx - Math.PI/2) < tol || Math.abs(nx - Math.PI*3/2) < tol) {
      lblT.classList.add('active');
    }
  }

  drawShape(angleX, angleY);

  simCanvas.addEventListener('mousedown', (e) => {
    isDragging = true; lastMX = e.clientX; lastMY = e.clientY;
  });
  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    angleY += (e.clientX - lastMX) * 0.01;
    angleX += (e.clientY - lastMY) * 0.01;
    lastMX = e.clientX; lastMY = e.clientY;
    drawShape(angleX, angleY);
  });
  window.addEventListener('mouseup', () => { isDragging = false; });

  simCanvas.addEventListener('touchstart', (e) => {
    isDragging = true; lastMX = e.touches[0].clientX; lastMY = e.touches[0].clientY; e.preventDefault();
  });
  window.addEventListener('touchmove', (e) => {
    if (!isDragging) return;
    angleY += (e.touches[0].clientX - lastMX) * 0.01;
    angleX += (e.touches[0].clientY - lastMY) * 0.01;
    lastMX = e.touches[0].clientX; lastMY = e.touches[0].clientY;
    drawShape(angleX, angleY);
  });
  window.addEventListener('touchend', () => { isDragging = false; });
}

// ===== EMAIL PROTECTION =====
// Decode email-protect spans into visible text and mailto links
document.querySelectorAll('.email-protect').forEach(function(el) {
  var u = el.getAttribute('data-user');
  var d = el.getAttribute('data-domain');
  if (u && d) {
    var addr = u + '@' + d;
    el.innerHTML = '<a href="mai' + 'lto:' + addr + '" style="color:var(--accent-gold);text-decoration:none;">' + addr + '</a>';
  }
});
document.querySelectorAll('.email-protect-link').forEach(function(el) {
  var u = el.getAttribute('data-user');
  var d = el.getAttribute('data-domain');
  if (u && d) {
    el.href = 'mai' + 'lto:' + u + '@' + d;
  }
});

// ===== HERO SVG PARALLAX =====
const heroInteractive = document.getElementById('heroInteractive');
document.querySelector('.hero').addEventListener('mousemove', (e) => {
  const rect = e.currentTarget.getBoundingClientRect();
  const x = (e.clientX - rect.left) / rect.width - 0.5;
  const y = (e.clientY - rect.top) / rect.height - 0.5;
  heroInteractive.style.transform = `translate(calc(-50% + ${x * 30}px), calc(-50% + ${y * 30}px))`;
});

// ===== ADMIN CONTENT SYNC =====
// Loads content from site-content.json (deployed) or localStorage (local dev)
function applyContentData(data) {
  if (!data) return;

  // Hero video — supports YouTube URLs and direct video files
  if (data.heroVideoUrl) {
    const url = data.heroVideoUrl;
    // Extract YouTube video ID from various URL formats
    let ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([a-zA-Z0-9_-]{11})/);
    if (ytMatch) {
      // YouTube URL → replace <video> with muted autoplay iframe
      const videoEl = document.querySelector('.hero-video-bg');
      if (videoEl) {
        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + ytMatch[1] + '?autoplay=1&mute=1&loop=1&playlist=' + ytMatch[1] + '&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.className = 'hero-video-bg-yt';
        videoEl.parentNode.replaceChild(iframe, videoEl);
      }
    } else {
      // Direct video file URL
      const vid = document.querySelector('.hero-video-bg source');
      if (vid) { vid.src = url; vid.parentElement.load(); }
    }
  }
  if (data.heroPosterUrl) {
    const vidEl = document.querySelector('.hero-video-bg');
    if (vidEl) vidEl.poster = data.heroPosterUrl;
  }

  // Trailer YouTube ID — supports full URLs or just ID
  if (data.trailerYoutubeId) {
    let tid = data.trailerYoutubeId;
    var ytMatch2 = tid.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([a-zA-Z0-9_-]{11})/);
    if (ytMatch2) tid = ytMatch2[1];
    var trailerIframe = document.getElementById('trailerIframe');
    if (trailerIframe) {
      trailerIframe.src = 'https://www.youtube.com/embed/' + tid + '?rel=0';
    }
  }

  // Screenshots
  if (data.screenshots) {
    Object.keys(data.screenshots).forEach(slot => {
      const el = document.querySelector('[data-slot="' + slot + '"] img');
      if (el && data.screenshots[slot]) {
        el.src = data.screenshots[slot];
      }
    });
  }

  // Download links (Press Kit)
  if (data.downloads) {
    const dlMap = { 'dl-presskit': 0, 'dl-logo': 1, 'dl-screenshots': 2, 'dl-factsheet': 3 };
    const dlLinks = document.querySelectorAll('.download-list a');
    Object.keys(data.downloads).forEach(key => {
      const idx = dlMap[key];
      if (idx !== undefined && dlLinks[idx] && data.downloads[key]) {
        dlLinks[idx].href = data.downloads[key];
        dlLinks[idx].target = '_blank';
      }
    });
  }

  // Community links
  if (data.communityLinks) {
    const communityLinks = document.querySelectorAll('.community-grid .community-link');
    const linkOrder = ['link-discord','link-twitter','link-youtube','link-reddit','link-steam'];
    linkOrder.forEach((key, idx) => {
      if (data.communityLinks[key] && communityLinks[idx]) {
        communityLinks[idx].href = data.communityLinks[key];
        communityLinks[idx].target = '_blank';
      }
    });
  }

  // Footer links (Privacy, Terms, Contact page URLs)
  if (data.footerLinks) {
    var footerAnchors = document.querySelectorAll('.footer-links a');
    footerAnchors.forEach(function(a) {
      var text = a.textContent.trim().toLowerCase();
      if (text.includes('privacy') && data.footerLinks.privacy) {
        a.href = data.footerLinks.privacy;
        a.target = '_blank';
      } else if (text.includes('terms') && data.footerLinks.terms) {
        a.href = data.footerLinks.terms;
        a.target = '_blank';
      }
    });
    // Contact URL (if not email-protected link)
    var contactLink = document.querySelector('.footer-links a:not(.email-protect-link)[href="#"]');
    if (contactLink && data.footerLinks.contact) {
      contactLink.href = data.footerLinks.contact;
      contactLink.target = '_blank';
    }
  }
}

// Try fetching site-content.json first, fallback to localStorage
fetch('/js/site-content.json')
  .then(r => { if (!r.ok) throw new Error('no json'); return r.json(); })
  .then(data => applyContentData(data))
  .catch(() => {
    try {
      const raw = localStorage.getItem('lightersgames-content');
      if (raw) applyContentData(JSON.parse(raw));
    } catch(e) {}
  });
</script>
</body>
</html>
