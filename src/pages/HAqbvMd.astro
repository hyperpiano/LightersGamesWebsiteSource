---
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
---
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="author" content="HuiBeom Jung"/>
	<meta name="keywords" content="LightersGames"/>
	<meta property="twitter:description" content="HAqbvMd">
	<meta itemprop="description" content="HAqbvMd">
	<link rel="icon" type="image/png" sizes="40x40" href="/favicon-40x40.png" />

	<script defer data-domain="lightersgames.com" src="/js/script.js"></script>
	<script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
	<style>
		/* Aura effect styles */
		#aura {
			position: fixed;
			width: 250px;
			height: 250px;
			pointer-events: none;
			border-radius: 75%;
			/* Brighter, sharper edges */
			background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.2) 40%, rgba(255,255,255,0) 70%);
			filter: blur(8px); /* less blur = sharper edges */
			transform: translate(-50%, -50%);
			transition: transform 0.05s ease-out;
			z-index: 9999;
		}
		/* Hide default cursor globally */
		* {
			cursor: none !important;
		}
		body {
			background-color: #000000;
			margin: 0;
			padding: 0;
		}
		html {
			background-color: #000000;
		}
		
		/* Content container */
		#content {
			position: relative;
		}
		
		/* Text elements with individual masking */
		.masked-text {
			color: #ffffff;
			font-family: Arial, sans-serif;
			--mouse-x: -1000px;
			--mouse-y: -1000px;
			mask: radial-gradient(circle 150px at var(--mouse-x) var(--mouse-y), white 0%, white 40%, transparent 70%);
			-webkit-mask: radial-gradient(circle 150px at var(--mouse-x) var(--mouse-y), white 0%, white 40%, transparent 70%);
		}
		
		/* Content sections */
		.content-section {
			position: relative;
			color: #ffffff;
			font-family: Arial, sans-serif;
		}
		
		/* Images - always visible, no masking */
		.visible-image {
			position: relative;
			display: inline-block;
			/* No masking applied - always visible */
		}
		
		.visible-image img {
			display: block;
		}
	</style>
</head>
<body>
	<!-- Aura -->
	<div id="aura"></div>
	<!-- Custom cursor image -->
	<img id="cursorImage" src="/img/custom-cursor.png" alt="Cursor" />
	
	<div id="content">
		<div class="content-section" style="padding: 50px; font-size: 24px;">
			<h1 class="masked-text">Hidden Gallery</h1>
			<p class="masked-text">Move your aura to find images, then click to reveal their true content!</p>
			
			<!-- Image 1 - Always visible -->
			<div class="visible-image" style="margin: 20px;">
				<img src="/img/reveal/show-hexagon.png" alt="Image 1" width="200" height="150">
			</div>
		</div>
		
		<div class="content-section" style="position: absolute; top: 300px; left: 400px; font-size: 18px;">
			<h2 class="masked-text">Secret Gallery Corner</h2>
			<p class="masked-text">Another hidden image awaits...</p>
			
			<!-- Image 2 - Always visible -->
			<div class="visible-image" style="margin: 15px 0;">
				<img src="/img/reveal/show-hexagon.png" alt="Image 2" width="150" height="200">
			</div>
		</div>
		
		<div class="content-section" style="position: absolute; bottom: 150px; right: 100px;">
			<p class="masked-text">Final secret image!</p>
			
			<!-- Image 3 - Always visible -->
			<div class="visible-image" style="margin-top: 10px;">
				<img src="/img/reveal/show-hexagon.png" alt="Image 3" width="180" height="120">
			</div>
		</div>
	</div>
	<script>
		const aura = document.getElementById("aura");
		const cursorImg = document.getElementById("cursorImage");
		const maskedTextElements = document.querySelectorAll('.masked-text');
		
		// Initialize with cursor at center and mask hidden
		document.body.style.setProperty('--mouse-x', '50%');
		document.body.style.setProperty('--mouse-y', '50%');
		
		document.addEventListener("mousemove", (e) => {
			// Move aura
			aura.style.left = `${e.clientX}px`;
			aura.style.top = `${e.clientY}px`;
			
			// Move custom cursor image
			cursorImg.style.left = `${e.clientX}px`;
			cursorImg.style.top = `${e.clientY}px`;
			
			// Update mask position for each text element individually using pixel coordinates
			maskedTextElements.forEach(element => {
				element.style.setProperty('--mouse-x', e.clientX + 'px');
				element.style.setProperty('--mouse-y', e.clientY + 'px');
			});
		});
	</script>
</body>
</html>