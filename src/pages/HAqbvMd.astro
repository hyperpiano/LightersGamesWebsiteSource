---
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
---
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="author" content="HuiBeom Jung"/>
	<meta name="keywords" content="LightersGames"/>
	<meta property="twitter:description" content="HAqbvMd">
	<meta itemprop="description" content="HAqbvMd">
	<link rel="icon" type="image/png" sizes="40x40" href="/favicon-40x40.png" />

	<script defer data-domain="lightersgames.com" src="/js/script.js"></script>
	<script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
	<style>
		#aura {
			position: fixed;
			width: 250px;
			height: 250px;
			pointer-events: none;
			border-radius: 75%;
			/* Brighter, sharper edges */
			background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.2) 40%, rgba(255,255,255,0) 70%);
			filter: blur(8px); /* less blur = sharper edges */
			transform: translate(-50%, -50%);
			transition: transform 0.05s ease-out, opacity 0.3s ease;
			z-index: 9999;
			opacity: 0; /* Start hidden */
		}
		
		/* Hidden aura state */
		#aura.hidden {
			opacity: 0;
		}
		
		/* Hide default cursor globally */
		* {
			cursor: none !important;
		}
		
		/* Prevent dragging and text selection */
		img {
			-webkit-user-drag: none;
			-khtml-user-drag: none;
			-moz-user-drag: none;
			-o-user-drag: none;
			user-drag: none;
			pointer-events: none;
		}
		
		* {
			-webkit-user-select: none;
			-moz-user-select: none;
			-ms-user-select: none;
			user-select: none;
		}
		body {
			background-color: #242424;
			margin: 0;
			padding: 0;
		}
		html {
			background-color: #242424;
		}
		
		/* Masked content styles */
		.masked-content {
			position: relative;
			color: #ffffff;
			font-family: Arial, sans-serif;
		}
		
		.mask-overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-color: #000000;
			z-index: 1000;
			pointer-events: none;
		}
		
		/* Image styles */
		.hidden-image {
			position: relative;
			display: inline-block;
			cursor: pointer;
		}
		
		.hidden-image img {
			display: block;
			transition: opacity 0.3s ease;
		}
		
		/* Black placeholder image (always visible) */
		.black-image {
			display: block;
			/* Apply black overlay to PNG silhouettes */
			filter: brightness(0);
		}
		
		/* True content image (hidden by default) */
		.true-image {
			position: absolute;
			top: 0;
			left: 0;
			opacity: 1;
			z-index: 1;
		}
		
		/* Revealed state */
		.hidden-image.revealed .true-image {
			opacity: 1;
		}
		
		.hidden-image.revealed .black-image {
			opacity: 0;
		}
		
		/* Reveal mask using CSS mask property */
		#revealMask {
			position: fixed;
			top: 0;
			left: 0;
			width: 100vw;
			height: 100vh;
			background: black;
			z-index: 1001;
			pointer-events: none;
			transition: mask 0.3s ease, -webkit-mask 0.3s ease;
		}
		
		/* Active mask state (with light circle) */
		#revealMask.active {
			mask: radial-gradient(circle 150px at var(--mouse-x, 50%) var(--mouse-y, 50%), transparent 0%, transparent 40%, black 70%);
			-webkit-mask: radial-gradient(circle 150px at var(--mouse-x, 50%) var(--mouse-y, 50%), transparent 0%, transparent 40%, black 70%);
		}
		
		/* Inactive mask state (no light circle - everything hidden) */
		#revealMask.inactive {
			mask: none;
			-webkit-mask: none;
		}
		
		/* Image overlay text - centered in the middle of the image */
		.image-overlay-text {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			font-size: 2pt;
			color: #ffffff;
			font-family: Arial, sans-serif;
			z-index: 2;
			pointer-events: none;
			text-shadow: 1px 1px 1px rgba(0,0,0,0.8);
		}
		.toggle-instructions {
			position: fixed;
			top: 20px;
			left: 20px;
			color: #ffffff;
			font-family: Arial, sans-serif;
			font-size: 14px;
			z-index: 10000;
			background: rgba(0,0,0,0.7);
			padding: 10px;
			border-radius: 5px;
		}
	</style>
</head>
<body>	
	<!-- Aura -->
	<div id="aura"></div>
	<!-- Custom cursor image -->
	<img id="cursorImage" src="/img/custom-cursor.png" alt="Cursor" />
	
	<!-- Reveal mask overlay -->
	<div id="revealMask" class="inactive"></div>
	
	<div id="content">
		<div class="masked-content" style="position: absolute; top: 200px; left: 100px; font-size: 18px;">
			<!-- Circle -->
			<div class="true-image" style="margin: 20px; position: relative;">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="?" width="150" height="150">
				<div class="image-overlay-text">F</div>
			</div>
		</div>
		
		<div class="masked-content" style="position: absolute; top: 300px; left: 400px; font-size: 18px;">
			<!-- Triangle -->
			<div class="true-image" style="margin: 15px 0; position: relative;">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="?" width="150" height="150">
				<div class="image-overlay-text">F</div>
			</div>
		</div>
		
		<div class="masked-content" style="position: absolute; bottom: 150px; right: 100px;">
			<!-- Square -->
			<div class="true-image" style="margin: 15px 0; position: relative;">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="?" width="150" height="150">
				<div class="image-overlay-text">F</div>
			</div>
		</div>
		
		<div class="masked-content" style="position: absolute; bottom: 400px; right: 500px;">
			<!-- Pentagon -->
			<div class="true-image" style="margin: 15px 0; position: relative;">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="?" width="150" height="150">
				<div class="image-overlay-text">F</div>
			</div>
		</div>
		
		<div class="masked-content" style="position: absolute; bottom: 15px; right: 700px;">
			<!-- Hexagon -->
			<div class="true-image" style="margin: 15px 0; position: relative;">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="?" width="150" height="150">
				<div class="image-overlay-text">F</div>
			</div>
		</div>
		
		<div class="masked-content" style="position: absolute; bottom: 700px; right: 100px;">
			<!-- Octagon -->
			<div class="true-image" style="margin: 15px 0; position: relative;">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="?" width="150" height="150">
				<div class="image-overlay-text">F</div>
			</div>
		</div>
	</div>
	<script>
		const aura = document.getElementById("aura");
		const cursorImg = document.getElementById("cursorImage");
		const revealMask = document.getElementById("revealMask");
		let auraEnabled = false; // Start with light off
		
		document.addEventListener("mousemove", (e) => {
			const x = (e.clientX / window.innerWidth) * 100;
			const y = (e.clientY / window.innerHeight) * 100;
			
			// Move aura
			aura.style.left = `${e.clientX}px`;
			aura.style.top = `${e.clientY}px`;
			
			// Move custom cursor image
			cursorImg.style.left = `${e.clientX}px`;
			cursorImg.style.top = `${e.clientY}px`;
			
			// Update mask position
			revealMask.style.setProperty('--mouse-x', x + '%');
			revealMask.style.setProperty('--mouse-y', y + '%');
		});
		
		// Handle mouse down to turn light on
		document.addEventListener('mousedown', (e) => {
			auraEnabled = true;
			aura.classList.remove('hidden');
			revealMask.classList.remove('inactive');
			revealMask.classList.add('active');
		});
		
		// Handle mouse up to turn light off
		document.addEventListener('mouseup', (e) => {
			auraEnabled = false;
			aura.classList.add('hidden');
			revealMask.classList.remove('active');
			revealMask.classList.add('inactive');
		});
	</script>
</body>
</html>