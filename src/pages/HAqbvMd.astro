---
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
---
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="author" content="HuiBeom Jung"/>
	<meta name="keywords" content="LightersGames"/>
	<meta property="twitter:description" content="HAqbvMd">
	<meta itemprop="description" content="HAqbvMd">
	<link rel="icon" type="image/png" sizes="40x40" href="/favicon-40x40.png" />
	<style is:global>
		@import "../styles/base.css";
	</style>
	<script defer data-domain="lightersgames.com" src="/js/script.js"></script>
	<script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</head>
<body>
	<main>
		<div id="content">
			<h1>Ominous music intensifies..</h1>
		</div>
	</main>
	<Footer />
</body>
</html>

<style>
	main {
		background-color: #242424;
		position: relative;
		max-width: 1920px;
		margin: auto;
		padding-bottom: 4em;
		color: white;
	}

	#content {
		max-width: 80ch;
		margin: 0 auto;
		padding: 2ch;
		line-height: 1.6;
	}

	h1 {
		text-align: center;
		margin-bottom: 1em;
		font-size: 2.5em;
		font-weight: 300;
		letter-spacing: 2px;
	}

	h2 {
		margin-top: 2em;
		margin-bottom: 0.5em;
		font-size: 1.5em;
		font-weight: 400;
		color: #ffffff;
		border-bottom: 1px solid #444;
		padding-bottom: 0.25em;
	}

	h3 {
		margin-top: 1.5em;
		margin-bottom: 0.5em;
		font-size: 1.2em;
		font-weight: 400;
		color: #cccccc;
	}

	p {
		margin-bottom: 1em;
		text-align: left;
	}

	ul {
		margin-bottom: 1em;
		padding-left: 2em;
	}

	li {
		margin-bottom: 0.5em;
	}

	em {
		color: #aaaaaa;
		font-style: italic;
	}

	strong {
		font-weight: 600;
	}

	/* Responsive styles */
	@media screen and (max-width: 768px) {
		#content {
			padding: 1ch;
			max-width: 95%;
		}

		h1 {
			font-size: 2em;
		}

		h2 {
			font-size: 1.3em;
		}

		h3 {
			font-size: 1.1em;
		}
	}

	@media screen and (max-width: 500px) {
		#content {
			padding: 0.8ch;
		}

		h1 {
			font-size: 1.8em;
			letter-spacing: 1px;
		}
	}

	.table_component {
		overflow: auto;
		width: 100%;
	}
	
	.table_component table {
		border: 1px solid #3c3c49;
		height: 100%;
		width: 100%;
		table-layout: auto;
		border-collapse: collapse;
		border-spacing: 1px;
		text-align: center;
	}
	
	.table_component caption {
		caption-side: top;
		text-align: left;
	}
	
	.table_component th {
		border: 1px solid #3c3c49;
		background-color: #eceff1;
		color: #000000;
		padding: 5px;
}

.table_component td {
    border: 1px solid #3c3c49;
    background-color: #ffffff;
    color: #000000;
    padding: 5px;
}
</style>