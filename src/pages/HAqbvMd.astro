---
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
---
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="author" content="HuiBeom Jung"/>
	<meta name="keywords" content="LightersGames"/>
	<meta property="twitter:description" content="HAqbvMd">
	<meta itemprop="description" content="HAqbvMd">
	<link rel="icon" type="image/png" sizes="40x40" href="/favicon-40x40.png" />

	<script defer data-domain="lightersgames.com" src="/js/script.js"></script>
	<script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
	<style>
		/* Aura effect styles */
		#aura {
			position: fixed;
			width: 400px;
			height: 400px;
			pointer-events: none;
			border-radius: 50%;
			/* Brighter, sharper edges */
			background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.2) 40%, rgba(255,255,255,0) 70%);
			filter: blur(8px); /* less blur = sharper edges */
			transform: translate(-50%, -50%);
			transition: transform 0.05s ease-out;
			z-index: 9999;
		}
		/* Hide default cursor globally */
		* {
			cursor: none !important;
		}
		body {
			background-color: #000000;
			margin: 0;
			padding: 0;
		}
		html {
			background-color: #000000;
		}
		
		/* Masked content styles */
		.masked-content {
			position: relative;
			color: #ffffff;
			font-family: Arial, sans-serif;
		}
		
		.mask-overlay {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-color: #000000;
			z-index: 1000;
			pointer-events: none;
		}
		
		/* Image styles */
		.hidden-image {
			position: relative;
			display: inline-block;
			cursor: pointer;
		}
		
		.hidden-image img {
			display: block;
			transition: opacity 0.3s ease;
		}
		
		/* Black placeholder image (always visible) */
		.black-image {
			display: block;
			/* Apply black overlay to PNG silhouettes */
			filter: brightness(0);
		}
		
		/* True content image (hidden by default) */
		.true-image {
			position: absolute;
			top: 0;
			left: 0;
			opacity: 0;
			z-index: 1;
		}
		
		/* Revealed state */
		.hidden-image.revealed .true-image {
			opacity: 1;
		}
		
		.hidden-image.revealed .black-image {
			opacity: 0;
		}
		
		/* Reveal mask using CSS mask property */
		#revealMask {
			position: fixed;
			top: 0;
			left: 0;
			width: 100vw;
			height: 100vh;
			background: black;
			z-index: 1001;
			pointer-events: none;
			mask: radial-gradient(circle 150px at var(--mouse-x, 50%) var(--mouse-y, 50%), transparent 0%, transparent 40%, black 70%);
			-webkit-mask: radial-gradient(circle 150px at var(--mouse-x, 50%) var(--mouse-y, 50%), transparent 0%, transparent 40%, black 70%);
		}
	</style>
</head>
<body>
	<!-- Aura -->
	<div id="aura"></div>
	<!-- Custom cursor image -->
	<img id="cursorImage" src="/img/custom-cursor.png" alt="Cursor" />
	
	<!-- Reveal mask overlay -->
	<div id="revealMask"></div>
	
	<div id="content">
		<div class="masked-content" style="padding: 50px; font-size: 24px;">
			<h1>Hidden Gallery</h1>
			<p>Move your aura to find images, then click to reveal their true content!</p>
			
			<!-- Hidden Image 1 -->
			<div class="hidden-image" style="margin: 20px;">
				<img class="black-image" src="/img/reveal/hide-hexagon.png" alt="Silhouette 1" width="200" height="150">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="Revealed Image 1" width="200" height="150">
			</div>
		</div>
		
		<div class="masked-content" style="position: absolute; top: 300px; left: 400px; font-size: 18px;">
			<h2>Secret Gallery Corner</h2>
			<p>Another hidden image awaits...</p>
			
			<!-- Hidden Image 2 -->
			<div class="hidden-image" style="margin: 15px 0;">
				<img class="black-image" src="/img/reveal/hide-hexagon.png" alt="Silhouette 2" width="150" height="200">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="Revealed Image 2" width="150" height="200">
			</div>
		</div>
		
		<div class="masked-content" style="position: absolute; bottom: 150px; right: 100px;">
			<p>Final secret image!</p>
			
			<!-- Hidden Image 3 -->
			<div class="hidden-image" style="margin-top: 10px;">
				<img class="black-image" src="/img/reveal/hide-hexagon.png" alt="Silhouette 3" width="180" height="120">
				<img class="true-image" src="/img/reveal/show-hexagon.png" alt="Revealed Image 3" width="180" height="120">
			</div>
		</div>
	</div>
	<script>
		const aura = document.getElementById("aura");
		const cursorImg = document.getElementById("cursorImage");
		const revealMask = document.getElementById("revealMask");
		
		document.addEventListener("mousemove", (e) => {
			const x = (e.clientX / window.innerWidth) * 100;
			const y = (e.clientY / window.innerHeight) * 100;
			
			// Move aura
			aura.style.left = `${e.clientX}px`;
			aura.style.top = `${e.clientY}px`;
			
			// Move custom cursor image
			cursorImg.style.left = `${e.clientX}px`;
			cursorImg.style.top = `${e.clientY}px`;
			
			// Update mask position
			revealMask.style.setProperty('--mouse-x', x + '%');
			revealMask.style.setProperty('--mouse-y', y + '%');
		});
		
		// Handle image clicking to reveal true content
		document.addEventListener('click', (e) => {
			const hiddenImage = e.target.closest('.hidden-image');
			if (hiddenImage) {
				hiddenImage.classList.toggle('revealed');
			}
		});
	</script>
</body>
</html>