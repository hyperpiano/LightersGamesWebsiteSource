---
// Reference from bMvdpAH.astro [cite: 1]
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
---

<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="author" content="HuiBeom Jung"/>
	<meta name="keywords" content="LightersGames, Secret"/>
	<title>xh2kbzov - Secret Page</title>
	
	<link rel="icon" type="image/png" sizes="40x40" href="/favicon-40x40.png" />
	<style is:global>
		@import "../styles/base.css";
	</style>

	<script defer data-domain="lightersgames.com" src="/js/script.js"></script>
</head>
<body>
	<main>
		<div id="content">
			<h1><b>Creating more secrets.</b></h1>
			<p class="description">This is all that is prepared so far....</p>
			
			<div class="reward-section">
				<p>However, it's truly amazing that you've made it this far.</p>
				<strong>Please show this screenshot on Discord!</strong>
			</div>

			<div class="clock-container">
				<p id="current-date"></p>
				<p id="current-time"></p>
			</div>
		</div>
	</main>

	<Footer />

	<script>
		function updateClock() {
			const now = new Date();
			
			// Date formatting (e.g., Wednesday, January 7, 2026)
			const dateOptions = { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' };
			const dateString = now.toLocaleDateString('en-US', dateOptions);
			
			// Time formatting (e.g., 4:34:05 PM)
			const timeString = now.toLocaleTimeString('en-US', { hour12: true });

			const dateElement = document.getElementById('current-date');
			const timeElement = document.getElementById('current-time');

			if (dateElement) dateElement.textContent = dateString;
			if (timeElement) timeElement.textContent = timeString;
		}

		// Update every second
		setInterval(updateClock, 1000);
		// Run immediately on load
		updateClock();
	</script>
</body>
</html>

<style>
	/* Layout styles following reference guide [cite: 4, 5] */
	main {
		background-color: #242424;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		margin: auto;
		text-align: center;
	}

	#content {
		max-width: 80ch;
		padding: 2ch;
		line-height: 1.6;
	}

	h1 {
		font-size: 2.5em;
		font-weight: 300;
		letter-spacing: 2px;
		margin-bottom: 0.5em;
	}

	.description {
		color: #aaaaaa; /* Similar to em style in reference [cite: 8] */
		font-size: 1.2em;
		margin-bottom: 2em;
	}

	.reward-section {
		background: rgba(255, 255, 255, 0.05);
		padding: 25px;
		border-radius: 8px;
		border: 1px solid #444;
		margin-bottom: 3em;
	}

	strong {
		color: #ffffff;
		font-size: 1.3em;
		display: block;
		margin-top: 10px;
		font-weight: 600; /* [cite: 8] */
	}

	/* Clock Style */
	.clock-container {
		font-family: 'Courier New', Courier, monospace;
		border-top: 1px solid #444;
		padding-top: 2em;
	}

	#current-date {
		font-size: 1.1em;
		color: #cccccc; /* [cite: 7] */
		margin-bottom: 5px;
	}

	#current-time {
		font-size: 2.2em;
		font-weight: bold;
		color: #ffffff;
	}

	/* Responsive design based on reference [cite: 9, 10] */
	@media screen and (max-width: 768px) {
		h1 { font-size: 2em; }
		#current-time { font-size: 1.6em; }
	}
</style>