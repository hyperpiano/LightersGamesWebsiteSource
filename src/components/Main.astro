---
import Awards from '../components/Awards.astro';
import YouTube from '../components/YouTube.astro';
import Screenshot from '../components/Screenshot.astro';
import SteamButton from '../components/SteamButton.astro';
import EpicGamesStoreButton from '../components/EpicGamesStoreButton.astro';
import SocialMediaButton from '../components/SocialMediaButton.astro';
---
<main>
	<div class="trailer-image">
		<img src="/img/trailer_img.webp" alt="Game trailer image" loading="eager" width="1920" height="700" />
	</div>
	<div id="content">
		<p class="hero">
			THIS IS <strong>NOT</strong> A HEXAGON.
		</p>
		<div class="hero-image">
			<img src="/img/black_notahex.webp" alt="Not a hexagon" class="center" />
		</div>
		<p class="hero">
			Shine the light to reveal its true form.
		</p>
		<div class="hero-image">
			<img src="/img/ItWasntAHexagon.gif" alt="Light revealing true form" class="center" />
		</div>
		<h2><span style="font-family: 'Paperlogy-6SemiBold', serif;">Trailer</span></h2>
		<YouTube id="yorJhmG2kHE" alt="Play video: ThanksLight trailer" />
		<ul class="stores">
			<li><SteamButton /></li>
			<li><EpicGamesStoreButton /></li>
		</ul>
		<h2><span style="font-family: 'Paperlogy-6SemiBold', serif;">About</span></h2>
		<p>
			<b>"THANKS, LIGHT."</b> is a puzzle-platformer where you manipulate light—shining or absorbing it—to transform objects between 2D and 3D forms.
			Don't be deceived by silhouettes—shine light to unveil the true forms of objects. Engage with our puzzles and uncover the mystery!
		</p>
		<ul class="socials">
			<li><SocialMediaButton text="Reddit" linkUrl="https://www.reddit.com/user/THANKLIGHT/" iconUrl="/img/reddit-logo.png" /></li>
			<li><SocialMediaButton text="X / Twitter" linkUrl="https://x.com/TeamLightersTL/" iconUrl="/img/x-logo.png" /></li>
			<li><SocialMediaButton text="Youtube" linkUrl="https://www.youtube.com/@Lightersgames" iconUrl="/img/youtube-logo.png" /></li>
			<li><SocialMediaButton text="Press Kit" linkUrl="https://drive.google.com/drive/u/0/folders/1n39FotFqB-3vY08dP57ZI-pf5lJ0aFia/" iconUrl="/img/press_kit_icon.png" /></li>
		</ul>
		<h2><span style="font-family: 'Paperlogy-6SemiBold', serif;">The Team</span></h2>
		<p>
			We are <b>Lightersgames Inc.</b>, an indie game studio based in Korea, currently developing our debut title.
			The name Lighters represents our desire to illuminate new paths—creating games that explore fresh ideas and uncharted territory.
			Our goal is simple: to craft experiences that stay with players long after the game is over—memorable, meaningful, and never just momentary entertainment.
		</p>
		<ul class="team">
			<li><small>Huibeom Jung</small></li>
			<li><small>Seohyeon Lee</small></li>
			<li><small>Jeongtae Go</small></li>
			<li><small>Taewook Koh</small></li>
		</ul>
		<h2><span style="font-family: 'Paperlogy-6SemiBold', serif;">Screenshots</span></h2>
		<div class="screenshots">
			<Screenshot id={2} />
			<Screenshot id={3} />
			<Screenshot id={4} />
			<Screenshot id={5} />
		</div>
		<ul class="stores">
			<li><SteamButton /></li>
			<li><EpicGamesStoreButton /></li>
		</ul>
	</div>
</main>

<style>
	p {
		margin: auto;
		margin-bottom: 1.5em;
		text-align: left;
	}

	h2 {
		text-transform: uppercase;
		margin-top: 2em;
		margin-bottom: 0.25em;
		font-weight: 300;
		font-size: 1.25em;
		letter-spacing: 3px;
		text-align: center;
	}

	main {
		background-color: #242424;
		position: relative;
		max-width: 1920px;
		margin: auto;
		padding-bottom: 4em;
	}

	.background0 {
		margin-top: -100%;
		width: 100%;
		padding-bottom: calc(2ch - 4px);
		user-select: none;
		pointer-events: none;
		height: 100%;
	}

	/* Mobile-friendly image containers */
	.trailer-image, .hero-image {
		text-align: center;
		width: 100%;
		overflow: hidden;
	}

	.trailer-image img, .hero-image img {
		max-width: 100%;
		height: auto;
	}

	.hero {
		margin-top: 1rem;
		text-align: center;
	}

	.hero strong {
		font-size: 1.2em;
	}

	#content {
		max-width: 80ch;
		margin: 0 auto;
		padding: 2ch;
		padding-top: 0;
	}

	ul.team {
		display: flex;
		padding: 0;
		list-style: none;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1em 2em;
	}

	.socials {
		text-align: left;
		padding: 0;
		list-style-type: none;
		display: flex;
		justify-content: center;
		gap: 1em;
		flex-wrap: wrap;
	}

	.stores {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1em;
		padding: 0;
		list-style-type: none;
	}

	.screenshots {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 1em auto 3em auto;
		justify-content: center;
	}

	/* Enhanced responsive styles */
	@media screen and (max-width: 768px) {
		#content {
			padding: 1ch;
			max-width: 95%;
		}

		h2 {
			font-size: 1.1em;
			letter-spacing: 2px;
		}

		.screenshots {
			gap: 0.3em;
		}
	}

	@media screen and (max-width: 500px) {
		.socials {
			flex-direction: column;
			align-items: center;
		}

		.socials li {
			width: 80%;
		}

		.hero strong {
			font-size: 1.1em;
		}

		#content {
			padding: 0.8ch;
		}
	}
</style>
